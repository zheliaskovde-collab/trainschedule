  // Relations

  core_models_Route -> core_models_Train
  [label=" train (route)"] [arrowhead=none, arrowtail=dot, dir=both];

  core_models_RoutePoint -> core_models_Route
  [label=" route (points)"] [arrowhead=none, arrowtail=dot, dir=both];

  core_models_RoutePoint -> core_models_Station
  [label=" station (routepoint)"] [arrowhead=none, arrowtail=dot, dir=both];


